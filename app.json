{
  "expo": {
    "name": "AfriExpress",
    "slug": "afriexpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "afriexpress",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8590C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afriexpress.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.692647906393-pdm3jv1fs51rr6a3a9csh7343q8or9qr"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.afriexpress.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "afriexpress"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E8590C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E8590C",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AfriExpress utilise la caméra pour rechercher des articles par photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfriExpress accède à vos photos pour la photo de profil et la recherche visuelle."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AfriExpress utilise le micro pour envoyer des messages vocaux."
        }
      ],
      "expo-video",
      "expo-image",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#E8590C"
        }
      ]
    ],
    "extra": {
      "USE_MOCK": true,
      "router": {},
      "eas": {
        "projectId": "9bad96ed-3322-4da0-b458-adb3d255f779"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "maiga123"
  }
}
